# =============================================================================
# JurisPulse — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=JurisPulse
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://jurispulse:changeme@localhost:5432/jurispulse
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# JWT (for internal service tokens — not Supabase auth tokens)
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
# -----------------------------------------------------------------------------
SECRET_KEY=generate-a-strong-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# -----------------------------------------------------------------------------
# Storage
# Provider options: SUPABASE | LOCAL | MINIO | S3
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=SUPABASE
STORAGE_BUCKET=jurispulse-documents
LOCAL_STORAGE_PATH=./storage

# MinIO (only if STORAGE_PROVIDER=MINIO)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50

# -----------------------------------------------------------------------------
# OCR
# Requires: apt-get install tesseract-ocr tesseract-ocr-hin
# -----------------------------------------------------------------------------
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng+hin
OCR_DPI=300

# -----------------------------------------------------------------------------
# AI Services
# These are the URLs of the separately running AI service containers.
# The backend NEVER loads model weights directly.
# -----------------------------------------------------------------------------
AI_DRAFTER_URL=http://localhost:8001
AI_EMBEDDING_URL=http://localhost:8002
AI_VERIFICATION_URL=http://localhost:8003
AI_SERVICE_TIMEOUT=120

# -----------------------------------------------------------------------------
# Vector Search (Supabase pgvector)
# The existing legal index lives here — do NOT recreate it.
# -----------------------------------------------------------------------------
VECTOR_SEARCH_TABLE=legal_chunks
VECTOR_SEARCH_FUNCTION=match_legal_chunks
EMBEDDING_DIMENSION=384
DEFAULT_SEARCH_LIMIT=10

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# Logging
# LOG_FORMAT: json | text
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Feature Flags
# These are FALSE until actual models are trained and deployed.
# Do NOT set to TRUE without a real model behind the service.
# -----------------------------------------------------------------------------
ENABLE_HALLUCINATION_DETECTION=false
ENABLE_NER=false
ENABLE_AUTO_CLASSIFICATION=false
ENABLE_RISK_ASSESSMENT=false

# -----------------------------------------------------------------------------
# Audit
# -----------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TIME_LIMIT=3600
